//kage:unit pixels
package main

var Texture float
var Offset vec2
var Scale float

func noise(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * .1031)
	q += dot(q, q.yzx+vec3(33.33))
	return fract((q.x + q.y) * q.z)
}

// Preserve the antialiased silhouette and the hard boundaries between toon
// bands. Sampling neighboring pixels would blur the outlines and highlights.
func Fragment(dst vec4, src vec2, color vec4) vec4 {
	c := imageSrc0At(src)

	// Fine grain follows world coordinates, remaining still during scrolling
	// and reproducing exactly when a cached section is regenerated.
	p := (src - imageSrc0Origin() + Offset) * Scale
	grain := noise(floor(p)) - .5
	rgb := c.rgb + vec3(grain * .004 * Texture) * c.a
	return vec4(clamp(rgb, vec3(0), vec3(c.a)), c.a)
}
