//kage:unit pixels
package main

var Light vec3

func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	n := vec3(custom.zw, sqrt(max(.0025, 1.0-dot(custom.zw, custom.zw))))
	direct := .72 * max(0.0, dot(normalize(n), Light))
	// Only the direct component is blocked. Ambient rock remains visible.
	share := direct / (.28 + direct)
	return vec4(vec3(share), 1)
}
