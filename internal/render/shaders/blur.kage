//kage:unit pixels
package main

var Step vec2

// Explicit bilinear sampling makes fractional softness continuous. Safe reads
// outside the image return transparent pixels, including at the cave floor.
func sample(p vec2) vec4 {
	p -= vec2(.5)
	base := floor(p) + vec2(.5)
	f := fract(p)
	a := mix(imageSrc0At(base), imageSrc0At(base+vec2(1, 0)), f.x)
	b := mix(imageSrc0At(base+vec2(0, 1)), imageSrc0At(base+vec2(1, 1)), f.x)
	return mix(a, b, f.y)
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	// Nine-tap Gaussian grouped into five bilinear samples. The two passes
	// blur premultiplied color and alpha together, avoiding colored halos.
	result := sample(src) * .2270270270
	result += (sample(src+Step*1.3846153846) + sample(src-Step*1.3846153846)) * .3162162162
	result += (sample(src+Step*3.2307692308) + sample(src-Step*3.2307692308)) * .0702702703
	return result
}
