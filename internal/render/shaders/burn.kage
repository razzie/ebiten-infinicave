//kage:unit pixels
package main

var Progress float
var Origin vec2
var Pixels float

func hash(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * .1031)
	q += dot(q, q.yzx+vec3(33.33))
	return fract((q.x+q.y)*q.z)
}

func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	f = f*f*(3-2*f)
	return mix(mix(hash(i), hash(i+vec2(1, 0)), f.x), mix(hash(i+vec2(0, 1)), hash(i+vec2(1, 1)), f.x), f.y)
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	c := imageSrc0At(src)
	// World coordinates keep the burn pattern stable across tiles and resizing.
	p := (src-imageSrc0Origin())/Pixels + Origin
	n := noise(p*170)*.7 + noise(p*431)*.3
	threshold := mix(-.12, 1.12, Progress)
	coverage := smoothstep(threshold, threshold+.035, n)
	edge := (1-smoothstep(threshold+.035, threshold+.16, n))*smoothstep(0, .1, Progress)
	// Alpha stays premultiplied even on fine silk and antialiased blades.
	ember := mix(vec3(.85, .12, .015), vec3(1, .8, .24), edge)
	rgb := mix(c.rgb, ember*c.a, edge)
	return vec4(rgb, c.a)*coverage
}
