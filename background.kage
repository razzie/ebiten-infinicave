//kage:unit pixels
package main

var Opacity float

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	background := imageSrc0At(src)
	shadow := imageSrc1At(src).a
	coverage := imageSrc2At(src).a
	// Preserve original coverage so blur never fills missing terrain or leaks
	// below the floor. Normalize color at transparent edges before shading.
	rgb := background.rgb / max(background.a, .0001)
	return vec4(rgb * (1.0-Opacity*shadow) * coverage, coverage)
}
