//kage:unit pixels
package main

var Texture float
var Offset vec2

func noise(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * .1031)
	q += dot(q, q.yzx+vec3(33.33))
	return fract((q.x + q.y) * q.z)
}

func smoothNoise(p vec2) float {
	cell := floor(p)
	f := fract(p)
	f = f * f * (3.0 - 2.0*f)
	a := mix(noise(cell), noise(cell+vec2(1, 0)), f.x)
	b := mix(noise(cell+vec2(0, 1)), noise(cell+vec2(1, 1)), f.x)
	return mix(a, b, f.y)
}

// Only cell faces pass through this shader. The wireframe and blue guides are
// drawn afterward. Source coordinates anchor the texture to the artwork.
// custom: distance to outer edge, face tilt, facet tone, edge light direction.
func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	rgb := color.rgb
	luminance := dot(rgb, vec3(.30, .59, .11))
	visible := smoothstep(.008, .13, luminance)
	p := src + Offset

	// Quiet mineral variation at several scales, with a slight planar tilt
	// and faint triangular facets. Avoid turning the faces into rounded tiles.
	mineral := (smoothNoise(p/83.0)-.5)*.055
	mineral += (smoothNoise(p/21.0)-.5)*.035
	mineral += (smoothNoise(p/5.0)-.5)*.012
	plane := custom.y*.055 + custom.z*.035
	rgb *= 1.0 + (mineral+plane)*Texture*visible

	// Fine matte grain stays static and fades out in the black pockets.
	grain := noise(floor(p)) - .5
	rgb += vec3(grain) * (.004+luminance*.009) * Texture * visible

	// A narrow directional rim gives lit cell boundaries a little relief.
	// It follows only the polygon perimeter, never the internal fan edges.
	rim := 1.0 - smoothstep(.10, 1.15, custom.x)
	rgb += vec3(1, .98, .92) * rim * custom.w * .025 * Texture * visible
	// Shader output uses premultiplied alpha for the transparent guide layer.
	return vec4(clamp(rgb, vec3(0), vec3(1)) * color.a, color.a)
}
