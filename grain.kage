//kage:unit pixels
package main

var Texture float
var Offset vec2

func noise(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * .1031)
	q += dot(q, q.yzx+vec3(33.33))
	return fract((q.x + q.y) * q.z)
}

func smoothNoise(p vec2) float {
	cell := floor(p)
	f := fract(p)
	f = f * f * (3.0 - 2.0*f)
	a := mix(noise(cell), noise(cell+vec2(1, 0)), f.x)
	b := mix(noise(cell+vec2(0, 1)), noise(cell+vec2(1, 1)), f.x)
	return mix(a, b, f.y)
}

// Only cell faces pass through this shader; outlines are drawn afterward.
// Source coordinates anchor the texture to the artwork.
// custom.y is continuous face tilt; custom.zw is the face normal in screen space.
func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	rgb := color.rgb
	luminance := dot(rgb, vec3(.30, .59, .11))
	visible := smoothstep(.008, .13, luminance)
	p := src + Offset

	// One continuous plane per rock. The triangles filling a concave or
	// merged face must not introduce their own wedge-shaped tonal seams.
	mineral := (smoothNoise(p/83.0)-.5)*.055
	mineral += (smoothNoise(p/21.0)-.5)*.035
	mineral += (smoothNoise(p/5.0)-.5)*.012
	// Faint mineral strokes run along the facet, with broad warping to avoid
	// repetitive stripes. Normal channels are constant across a whole face.
	n := custom.zw
	n = n / max(length(n), .15)
	t := vec2(-n.y, n.x)
	warp := smoothNoise(p/57.0)*3.0
	strokes := smoothNoise(vec2(dot(p,t)/63.0, dot(p,n)/8.0 + warp)) - .5
	mineral += strokes*.028
	plane := custom.y*.012
	rgb *= 1.0 + (mineral+plane)*Texture*visible

	// Fine matte grain stays static and fades out in the black pockets.
	grain := noise(floor(p)) - .5
	rgb += vec3(grain) * (.004+luminance*.009) * Texture * visible

	// Shader output uses premultiplied alpha for the transparent guide layer.
	return vec4(clamp(rgb, vec3(0), vec3(1)) * color.a, color.a)
}
