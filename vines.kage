//kage:unit pixels
package main

var Texture float
var Offset vec2

func noise(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * .1031)
	q += dot(q, q.yzx+vec3(33.33))
	return fract((q.x + q.y) * q.z)
}

// Blur the complete layer so forks soften together. Filtering premultiplied
// color and alpha keeps the transparent edges free of dark fringes.
func Fragment(dst vec4, src vec2, color vec4) vec4 {
	c := imageSrc0At(src) * .25
	c += (imageSrc0At(src+vec2(-1, 0)) + imageSrc0At(src+vec2(1, 0)) +
		imageSrc0At(src+vec2(0, -1)) + imageSrc0At(src+vec2(0, 1))) * .125
	c += (imageSrc0At(src+vec2(-1, -1)) + imageSrc0At(src+vec2(1, -1)) +
		imageSrc0At(src+vec2(-1, 1)) + imageSrc0At(src+vec2(1, 1))) * .0625

	// Fine grain follows world coordinates, remaining still during scrolling
	// and reproducing exactly when a cached section is regenerated.
	p := src - imageSrc0Origin() + Offset
	grain := noise(floor(p)) - .5
	rgb := c.rgb + vec3(grain * .012 * Texture) * c.a
	return vec4(clamp(rgb, vec3(0), vec3(c.a)), c.a)
}
